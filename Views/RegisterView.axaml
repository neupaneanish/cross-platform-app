<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TuinFounder.ViewModels"
             x:DataType="vm:RegisterViewModel"
             x:Class="TuinFounder.Views.RegisterView">
    <StackPanel Spacing="12" Width="512" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock
            Text="Register"
            HorizontalAlignment="Center"
            Classes="auth-header" />

        <Border
            Classes="errormessage"
            IsVisible="{Binding ErrorMessage,
                Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Classes="errormessage-text" />
        </Border>

        <StackPanel Orientation="Vertical" Spacing="4">
            <Label Content="Email" Target="Email" />
            <TextBox
                x:Name="Email"
                PlaceholderText="Email"
                Text="{Binding Email, UpdateSourceTrigger=LostFocus}"
                IsEnabled="{Binding !IsLoading}" />
        </StackPanel>

        <StackPanel Orientation="Vertical" Spacing="4">
            <Label Content="Password" Target="Password" />
            <TextBox PlaceholderText="Password"
                     x:Name="Password"
                     PasswordChar="*"
                     Text="{Binding Password, UpdateSourceTrigger=LostFocus}"
                     IsEnabled="{Binding !IsLoading}" />
        </StackPanel>

        <StackPanel Orientation="Vertical" Spacing="4">
            <Label Content="Confirm Password" Target="ConfirmPassword" />
            <TextBox PlaceholderText="Confirm Password"
                     x:Name="ConfirmPassword"
                     PasswordChar="*"
                     Text="{Binding ConfirmPassword, UpdateSourceTrigger=LostFocus}"
                     IsEnabled="{Binding !IsLoading}" />
        </StackPanel>

        <StackPanel Orientation="Vertical" Spacing="4">
            <Label Content="Phone" Target="Phone" />
            <TextBox PlaceholderText="Phone number country code"
                     x:Name="Phone"
                     Text="{Binding Phone, UpdateSourceTrigger=LostFocus}"
                     IsEnabled="{Binding !IsLoading}" />
        </StackPanel>

        <Button
            Content="Register"
            Classes="full primary"
            Command="{Binding SubmitCommand}"
            IsEnabled="{Binding !IsLoading}" />

        <Button
            Content="Back to login"
            Classes="transparent full"
            Command="{Binding NavigateToLoginCommand }" />

    </StackPanel>
</UserControl>