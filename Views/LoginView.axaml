<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TuinFounder.ViewModels"
             x:Class="TuinFounder.Views.LoginView"
             x:DataType="vm:LoginViewModel">
    <StackPanel Spacing="12" Width="512" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock
            Text="Welcome Back"
            HorizontalAlignment="Center"
            Classes="auth-header" />

        <Border
            Classes="errormessage"
            IsVisible="{Binding ErrorMessage,
            Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Classes="errormessage-text" />
        </Border>

        <StackPanel Orientation="Vertical" Spacing="4">
            <Label Content="Email" Target="Email" />
            <TextBox
                PlaceholderText="Email"
                x:Name="Email"
                Text="{Binding Email, UpdateSourceTrigger=LostFocus}"
                IsReadOnly="{Binding IsLoading}" />
        </StackPanel>

        <StackPanel Orientation="Vertical" Spacing="4">
            <Label Content="Password" Target="Password" />
            <TextBox
                PlaceholderText="Password"
                x:Name="Password"
                PasswordChar="*"
                Text="{Binding Password, UpdateSourceTrigger=LostFocus}"
                IsReadOnly="{Binding IsLoading}" />

        </StackPanel>

        <Button
            Content="Login"
            Classes="full primary"
            Command="{Binding SubmitCommand}"
            IsEnabled="{Binding !IsLoading}" />

        <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
            <Button
                Grid.Column="0"
                Content="Don't have an account? Signup"
                HorizontalAlignment="Left"
                Classes="ghost"
                Command="{Binding NavigateToRegisterCommand}"
                IsEnabled="{Binding !IsLoading}" />

            <Button
                Grid.Column="1"
                Content="Forget Password?"
                HorizontalAlignment="Right"
                Classes="ghost"
                Command="{Binding NavigateToForgetPasswordCommand}"
                IsEnabled="{Binding !IsLoading}" />
        </Grid>

    </StackPanel>
</UserControl>